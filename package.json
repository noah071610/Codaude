{
  "name": "ai-tracker",
  "displayName": "AI Token Tracker",
  "description": "Track Claude Code and Codex token usage in real time from the status bar.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-tracker.showDetails",
        "title": "AI Tracker: Show Token Usage"
      },
      {
        "command": "ai-tracker.openWindow",
        "title": "AI Tracker: Open Token Usage in New Window"
      }
    ],
    "icons": {
      "ai-tracker-claude": {
        "description": "Claude Code",
        "default": {
          "fontPath": "./media/ai-icons.woff",
          "fontCharacter": "\\E900"
        }
      },
      "ai-tracker-codex": {
        "description": "Codex",
        "default": {
          "fontPath": "./media/ai-icons.woff",
          "fontCharacter": "\\E901"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "aiTracker",
          "title": "AI Tokens",
          "icon": "$(ai-tracker-claude)"
        }
      ]
    },
    "views": {
      "aiTracker": [
        {
          "type": "webview",
          "id": "aiTracker.usage",
          "name": "Token Usage"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "dokomade": "file:../Projects/@Library/dokomade/dokomade-1.0.0.tgz"
  }
}
